# Backend Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas for production or local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/eva_db?retryWrites=true&wmajority
# Example Local: mongodb://127.0.0.1:27017/eva_db
MONGO_URI=mongodb://127.0.0.1:27017/eva_db

# JWT Secret Key for token signing and verification
JWT_SECRET=supersecretjwtkey123_replace_with_secure_random_string

# Environment: development or production
NODE_ENV=development
